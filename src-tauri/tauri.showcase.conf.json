{
  "productName": "DroidFun Workshop",
  "version": "0.4.3",
  "identifier": "com.droidfun.workshop.private",
  "build": {
    "beforeBuildCommand": "npm run build:studio"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "studio"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "shortDescription": "Private board setup and DroidFun screen controls",
    "macOS": {
