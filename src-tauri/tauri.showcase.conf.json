      "infoPlist": "Info.workshop.plist"
    }
  },
  "mainBinaryName": "droidfun-workshop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQUUxNjc5QzczMzg3QTIKUldTaWh6UEhlUmF1enliQnhrbGE1WHZBck1QazNybUdrd1FpaG5yYzUyVGxHNEkzZTRGU1ROTkcK",
      "endpoints": [
        "https://droidfun.io/api/workshop/updates/manifest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
