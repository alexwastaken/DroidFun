{
  "productName": "DroidFun Workshop",
  "version": "0.4.1",
  "identifier": "com.droidfun.workshop.private",
  "build": {
    "beforeBuildCommand": "npm run build:studio"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "studio"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "shortDescription": "Private board setup and DroidFun screen controls",
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.workshop.plist"
    }
  },
  "mainBinaryName": "droidfun-workshop",
  "plugins": {
    "updater": null
  }
}
