{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskbot",
  "version": "0.2.0",
  "identifier": "com.deskbot.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deskbot",
        "width": 440,
        "height": 760,
        "minWidth": 370,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#F3F8F5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
