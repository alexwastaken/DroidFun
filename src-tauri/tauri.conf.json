{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroidFun App",
  "version": "0.5.5",
  "identifier": "com.deskbot.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DroidFun App",
        "width": 440,
        "height": 760,
        "minWidth": 370,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#F8FAFC"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0"
    },
    "publisher": "Droid Fun",
    "homepage": "https://droidfun.io",
    "shortDescription": "Your Droid Fun desktop companion",
    "longDescription": "Choose faces, weather, stocks, timers and AI usage widgets for your USB-powered Droid Fun bot."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NDBFOEI5NzAyOTc0MEQKUldRTmRDbHd1ZWhBK0xWa3BHUVJ5aVltTEVVYm9OS3ExK0pHajF3R1kvT2NteGphREpFSXpxQmkK",
      "endpoints": [
        "https://raw.githubusercontent.com/alexwastaken/DroidFun/main/distribution/updater.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
