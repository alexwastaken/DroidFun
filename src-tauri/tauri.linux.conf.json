        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libudev1",
          "udev",
          "pkexec"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-droidfun.rules": "linux/70-droidfun.rules",
