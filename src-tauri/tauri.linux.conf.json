      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-droidfun.rules": "linux/70-droidfun.rules",
          "/usr/share/droidfun/70-droidfun.rules": "linux/70-droidfun.rules",
          "/usr/lib/droidfun/setup-robot-access": "linux/setup-robot-access",
          "/usr/share/polkit-1/actions/io.droidfun.usb-access.policy": "linux/io.droidfun.usb-access.policy"
        },
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm",
